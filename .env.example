# ===== Server =====
NODE_ENV=production
PORT=3000
# Public HTTPS address of this server (used in payment links and redirectUrl)
PUBLIC_BASE_URL=https://pay.your-domain.com
# Number of reverse-proxy hops in front of the app (Railway/Render/Nginx = 1)
TRUST_PROXY=1
# Random string, 32+ chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DB_PATH=./data/banxa-links.sqlite

# ===== Admin login =====
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- 'Your-Strong-Password'
ADMIN_PASSWORD_HASH=

# ===== Banxa (Hosted Checkout v2) =====
# sandbox first. Switch to production ONLY after Banxa approves your integration.
BANXA_ENV=sandbox
BANXA_PRODUCTION_APPROVED=false
# From Banxa Partner Dashboard (separate values for sandbox and production)
BANXA_PARTNER_REF=
BANXA_API_KEY=
# HMAC key pair (merchant dashboard / account manager) — required to verify webhooks
BANXA_HMAC_KEY=
BANXA_HMAC_SECRET=
# Banxa's blockchain code for USDT on TRON. Confirm with the "בדיקת הגדרות מול Banxa" button.
BANXA_BLOCKCHAIN_CODE=TRON
# Must match the webhook URL path you register in the Banxa dashboard
WEBHOOK_PATH=/webhooks/banxa

# ===== Business rules =====
MIN_USD=20
MAX_USD=10000
LINK_TTL_HOURS=24
MAX_ATTEMPTS_PER_LINK=3
POLL_INTERVAL_SEC=120
# After an ambiguous create (timeout/5xx), "order not found" is trusted only after this many seconds
RECONCILE_GRACE_SEC=90
# Banxa checkoutUrl validity (FAQ: 1 minute from the create-order response until first loaded).
# Customers are redirected only within TTL - MARGIN seconds of that response. Do not raise the TTL.
CHECKOUT_URL_TTL_SEC=60
CHECKOUT_URL_MARGIN_SEC=15
# Rate limits per IP (payment pages per 10 min, admin login per 15 min)
PAY_RATE_LIMIT=40
LOGIN_RATE_LIMIT=10

# Testing only — never set in production (the app refuses to start if you do)
# BANXA_API_BASE_OVERRIDE=
